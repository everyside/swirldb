---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Storage Adapters">
  <h1>Storage Adapters</h1>
  <p>SwirlDB uses a pluggable storage architecture. Choose the storage adapter that fits your needs.</p>

  <section>
    <h2>Available Adapters</h2>

    <div class="card">
      <h3>✅ InMemoryStorage (Default)</h3>
      <p><strong>Status:</strong> Implemented</p>
      <p><strong>Use case:</strong> Fast, volatile storage. Perfect for temporary data or when persistence isn't needed.</p>
      <pre><code>// TypeScript
const db = new SwirlDB(new WasmDB());

// Rust
let db = SwirlDB::new();</code></pre>
    </div>

    <div class="card">
      <h3>✅ LocalStorageAdapter</h3>
      <p><strong>Status:</strong> Implemented</p>
      <p><strong>Use case:</strong> Browser persistence with ~5-10MB storage. Perfect for user preferences and app state.</p>
      <pre><code>// TypeScript
const db = await SwirlDB.withLocalStorage('my-app');

// Rust (browser WASM)
let storage = LocalStorageAdapter::new("my-app")?;
let db = SwirlDB::with_storage(Arc::new(storage), "db");</code></pre>
    </div>

    <div class="card">
      <h3>✅ IndexedDBAdapter</h3>
      <p><strong>Status:</strong> Implemented</p>
      <p><strong>Use case:</strong> Browser persistence with ~50MB-1GB storage. Ideal for larger datasets.</p>
      <pre><code>{`// TypeScript
const db = await SwirlDB.withIndexedDB('my-app');

// Rust (browser WASM)
let storage = IndexedDBAdapter::new("my-app").await?;
let db = SwirlDB::with_storage(Arc::new(storage), "db").await;`}</code></pre>
    </div>

    <div class="card">
      <h3>🔜 redb Adapter</h3>
      <p><strong>Status:</strong> Planned</p>
      <p><strong>Use case:</strong> Native Rust embedded database with ACID guarantees. Perfect for server deployments.</p>
      <pre><code>// Rust (future)
let storage = RedbAdapter::new("./data")?;
let db = SwirlDB::with_storage(Arc::new(storage), "db");</code></pre>
    </div>
  </section>

  <section>
    <h2>Storage Hints</h2>
    <p>Control per-path storage policies with storage hints:</p>

    <div class="card">
      <h3>memory-only</h3>
      <p>Data is never persisted, even if using a persistent storage adapter.</p>
      <pre><code>db.setStorageHint('session.temp', 'memory-only');
db.data.session.temp = 'volatile-data';</code></pre>
    </div>

    <div class="card">
      <h3>persisted</h3>
      <p>Data is persisted to the storage adapter.</p>
      <pre><code>{`db.setStorageHint('user.profile', 'persisted');
db.data.user.profile = { name: 'Alice', email: 'alice@example.com' };`}</code></pre>
    </div>

    <div class="card">
      <h3>synced</h3>
      <p>Data is both persisted and synced with remote peers (future feature).</p>
      <pre><code>db.setStorageHint('shared.doc', 'synced');
db.data.shared.doc = 'Collaborative document';</code></pre>
    </div>
  </section>

  <section>
    <h2>Auto-Persistence</h2>
    <p>Enable automatic, debounced persistence after mutations:</p>

    <div class="card">
      <pre><code>const db = await SwirlDB.withLocalStorage('my-app');

// Enable with 500ms debounce
db.enableAutoPersist(500);

// These changes trigger one persisted save after 500ms
db.data.user.name = 'Alice';
db.data.user.email = 'alice@example.com';
db.data.user.age = 30;

// Disable auto-persist
db.disableAutoPersist();

// Manual persist
db.persist();</code></pre>
    </div>
  </section>

  <section>
    <h2>Interactive Demo</h2>
    <div class="demo-container">
      <div class="demo-controls">
        <button id="create-memory-btn" class="btn">Create Memory DB</button>
        <button id="create-persisted-btn" class="btn">Create Persisted DB (localStorage)</button>
        <button id="create-indexeddb-btn" class="btn" style="background: #3498db;">Create IndexedDB</button>
        <button id="write-btn" class="btn">Write Data</button>
        <button id="read-btn" class="btn">Read Data</button>
        <button id="enable-autopersist-btn" class="btn">Enable Auto-Persist</button>
        <button id="persist-btn" class="btn">Manual Persist</button>
        <button id="check-storage-btn" class="btn" style="background: #95a5a6;">Check localStorage</button>
        <button id="clear-btn" class="btn" style="background: #e74c3c;">Clear All</button>
      </div>

      <div class="demo-output">
        <h3>Output</h3>
        <div id="demo-log" class="log-area"></div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { SwirlDB } from '@swirldb/js';

  let db: any;

  async function initialize() {
    log('✅ SwirlDB ready', 'success');
  }

  function log(message: string, type: string = 'info') {
    const logArea = document.getElementById('demo-log');
    if (!logArea) return;

    const entry = document.createElement('div');
    entry.className = `log-entry ${type}`;
    const timestamp = new Date().toLocaleTimeString();
    entry.textContent = `[${timestamp}] ${message}`;
    logArea.prepend(entry);
  }

  // Event handlers
  document.getElementById('create-memory-btn')?.addEventListener('click', async () => {
    db = await SwirlDB.create();
    log('Created memory-only database', 'info');
  });

  document.getElementById('create-persisted-btn')?.addEventListener('click', async () => {
    db = await SwirlDB.withLocalStorage('swirl-docs-demo');
    log('Created persisted database (LocalStorage)', 'success');
  });

  document.getElementById('create-indexeddb-btn')?.addEventListener('click', async () => {
    try {
      db = await SwirlDB.withIndexedDB('swirl-docs-demo');
      log('✅ Created IndexedDB database (~50MB-1GB storage)', 'success');
    } catch (error) {
      log(`❌ Failed to create IndexedDB: ${error}`, 'error');
    }
  });

  document.getElementById('write-btn')?.addEventListener('click', () => {
    if (!db) {
      log('⚠️ Create database first', 'warning');
      return;
    }
    db.data.user.name = 'Alice';
    db.data.user.email = 'alice@example.com';
    db.data.timestamp = Date.now();
    log('Wrote user data', 'info');
  });

  document.getElementById('read-btn')?.addEventListener('click', () => {
    if (!db) {
      log('⚠️ Create database first', 'warning');
      return;
    }
    const name = db.data.user.name.$value;
    const email = db.data.user.email.$value;
    const timestamp = db.data.timestamp.$value;
    log(`Read: name=${name}, email=${email}, time=${timestamp}`, 'info');
  });

  document.getElementById('enable-autopersist-btn')?.addEventListener('click', () => {
    if (!db) {
      log('⚠️ Create database first', 'warning');
      return;
    }
    db.enableAutoPersist(500);
    log('✅ Auto-persist enabled (500ms debounce)', 'success');
  });

  document.getElementById('persist-btn')?.addEventListener('click', () => {
    if (!db) {
      log('⚠️ Create database first', 'warning');
      return;
    }
    db.persist();
    log('💾 Manually persisted to storage', 'success');
  });

  document.getElementById('check-storage-btn')?.addEventListener('click', () => {
    const keys = Object.keys(localStorage).filter(k => k.startsWith('swirl-docs-demo'));
    if (keys.length === 0) {
      log('No data in localStorage', 'info');
    } else {
      log(`Found ${keys.length} key(s) in localStorage`, 'info');
      keys.forEach(key => {
        const size = localStorage.getItem(key)?.length || 0;
        log(`  - ${key}: ${size} bytes`, 'info');
      });
    }
  });

  document.getElementById('clear-btn')?.addEventListener('click', () => {
    localStorage.removeItem('swirl-docs-demo:db');
    log('🗑️ Cleared all storage', 'warning');
    db = null;
  });

  // Initialize on load
  initialize();
</script>

<style>
  .demo-container {
    background: var(--bg-light);
    padding: 2rem;
    border-radius: 12px;
    margin: 2rem 0;
  }

  .demo-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .demo-output h3 {
    margin-top: 0;
    margin-bottom: 1rem;
    color: var(--primary);
  }

  .log-area {
    background: white;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
    max-height: 400px;
    overflow-y: auto;
    font-family: 'Monaco', 'Courier New', monospace;
    font-size: 0.9rem;
  }

  .log-entry {
    padding: 0.5rem;
    margin: 0.5rem 0;
    border-left: 3px solid var(--primary);
    background: var(--bg-light);
    border-radius: 4px;
  }

  .log-entry.success {
    border-left-color: var(--success);
    background: #edfff5;
  }

  .log-entry.warning {
    border-left-color: var(--warning);
    background: #fff9e6;
  }

  .log-entry.error {
    border-left-color: var(--error);
    background: #ffebeb;
  }
</style>
