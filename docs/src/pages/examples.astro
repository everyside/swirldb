---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Examples">
  <h1>Interactive Examples</h1>
  <p>Try out SwirlDB features right in your browser.</p>

  <section class="demo-section">
    <h2>1. Basic CRUD Operations</h2>
    <p>Create, read, update, and delete data with native property access.</p>

    <div class="demo-container">
      <div class="demo-controls">
        <button id="ex1-create" class="btn">Create User</button>
        <button id="ex1-read" class="btn">Read User</button>
        <button id="ex1-update" class="btn">Update User</button>
        <button id="ex1-delete" class="btn">Delete User</button>
      </div>
      <div class="demo-output">
        <div id="ex1-log" class="log-area"></div>
      </div>
    </div>
  </section>

  <section class="demo-section">
    <h2>2. Reactive Observers</h2>
    <p>Watch for changes and react to updates.</p>

    <div class="demo-container">
      <div class="demo-controls">
        <button id="ex2-add-observer" class="btn">Add Observer</button>
        <button id="ex2-change-value" class="btn">Change Value</button>
        <button id="ex2-rapid" class="btn">Rapid Changes (5)</button>
      </div>
      <div class="demo-output">
        <div id="ex2-log" class="log-area"></div>
      </div>
    </div>
  </section>

  <section class="demo-section">
    <h2>3. Nested Objects</h2>
    <p>Work with deeply nested data structures.</p>

    <div class="demo-container">
      <div class="demo-controls">
        <button id="ex3-create-tree" class="btn">Create Tree</button>
        <button id="ex3-read-deep" class="btn">Read Deep Value</button>
        <button id="ex3-show-all" class="btn">Show All Data</button>
      </div>
      <div class="demo-output">
        <div id="ex3-log" class="log-area"></div>
      </div>
    </div>
  </section>

  <section class="demo-section">
    <h2>4. Scoped Proxies</h2>
    <p>Use scoped proxies for cleaner code.</p>

    <div class="demo-container">
      <div class="demo-controls">
        <button id="ex4-scoped" class="btn">Use Scoped Proxy</button>
        <button id="ex4-batch" class="btn">Batch Operations</button>
      </div>
      <div class="demo-output">
        <div id="ex4-log" class="log-area"></div>
      </div>
    </div>
  </section>

  <section class="demo-section">
    <h2>5. Persistence Demo</h2>
    <p>Save and restore data across page reloads.</p>

    <div class="demo-container">
      <div class="demo-controls">
        <button id="ex5-save" class="btn">Save Data</button>
        <button id="ex5-load" class="btn">Load Data</button>
        <button id="ex5-clear" class="btn" style="background: #e74c3c;">Clear Storage</button>
        <button id="ex5-reload" class="btn" style="background: #95a5a6;">🔄 Reload Page</button>
      </div>
      <div class="demo-output">
        <div id="ex5-log" class="log-area"></div>
      </div>
    </div>
  </section>

  <section>
    <h2>More Examples</h2>
    <div class="card-grid">
      <div class="card">
        <h3>Storage Adapters</h3>
        <p>Explore different storage backends and persistence strategies.</p>
        <a href="/storage" class="btn">View Demo</a>
      </div>

      <div class="card">
        <h3>Proxy API</h3>
        <p>Learn about the native property access API.</p>
        <a href="/proxy-api" class="btn">Learn More</a>
      </div>

      <div class="card">
        <h3>Todo App</h3>
        <p>Build a complete todo application with SwirlDB.</p>
        <a href="/examples/todo" class="btn">Coming Soon</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { SwirlDB } from '@swirldb/js';

  let db: any;

  async function initialize() {
    db = await SwirlDB.create();
    console.log('✅ Examples initialized');
  }

  function log(id: string, message: string, type: string = 'info') {
    const logArea = document.getElementById(id);
    if (!logArea) return;

    const entry = document.createElement('div');
    entry.className = `log-entry ${type}`;
    const timestamp = new Date().toLocaleTimeString();
    entry.textContent = `[${timestamp}] ${message}`;
    logArea.prepend(entry);
  }

  // Example 1: CRUD
  document.getElementById('ex1-create')?.addEventListener('click', () => {
    db.data.user = {
      id: Date.now(),
      name: 'Alice',
      email: 'alice@example.com',
      role: 'admin'
    };
    log('ex1-log', 'Created user: Alice (admin)', 'success');
  });

  document.getElementById('ex1-read')?.addEventListener('click', () => {
    const user = db.data.user.$value;
    if (user) {
      log('ex1-log', `User: ${JSON.stringify(user, null, 2)}`, 'info');
    } else {
      log('ex1-log', 'No user found. Create one first!', 'warning');
    }
  });

  document.getElementById('ex1-update')?.addEventListener('click', () => {
    if (db.data.user.$value) {
      db.data.user.name = 'Alice Updated';
      db.data.user.lastModified = Date.now();
      log('ex1-log', 'Updated user name and timestamp', 'success');
    } else {
      log('ex1-log', 'No user to update. Create one first!', 'warning');
    }
  });

  document.getElementById('ex1-delete')?.addEventListener('click', () => {
    db.data.user.$delete();
    log('ex1-log', 'Deleted user', 'warning');
  });

  // Example 2: Observers
  let observerCount = 0;
  document.getElementById('ex2-add-observer')?.addEventListener('click', () => {
    observerCount++;
    const count = observerCount;
    db.data.watchedValue.$observe((value: any) => {
      log('ex2-log', `Observer #${count} fired: ${value}`, 'success');
    });
    log('ex2-log', `Added observer #${count}`, 'info');
  });

  document.getElementById('ex2-change-value')?.addEventListener('click', () => {
    const value = Math.floor(Math.random() * 100);
    db.data.watchedValue = value;
    log('ex2-log', `Changed value to: ${value}`, 'info');
  });

  document.getElementById('ex2-rapid')?.addEventListener('click', () => {
    for (let i = 0; i < 5; i++) {
      setTimeout(() => {
        db.data.watchedValue = i;
      }, i * 100);
    }
    log('ex2-log', 'Triggering 5 rapid changes...', 'info');
  });

  // Example 3: Nested Objects
  document.getElementById('ex3-create-tree')?.addEventListener('click', () => {
    db.data.app.config.database.host = 'localhost';
    db.data.app.config.database.port = 5432;
    db.data.app.config.cache.enabled = true;
    db.data.app.config.cache.ttl = 3600;
    log('ex3-log', 'Created nested configuration tree', 'success');
  });

  document.getElementById('ex3-read-deep')?.addEventListener('click', () => {
    const port = db.data.app?.config?.database?.port?.$value;
    if (port) {
      log('ex3-log', `Database port: ${port}`, 'info');
    } else {
      log('ex3-log', 'No nested data. Create tree first!', 'warning');
    }
  });

  document.getElementById('ex3-show-all')?.addEventListener('click', () => {
    const app = db.data.app.$value;
    if (app) {
      log('ex3-log', `Full tree: ${JSON.stringify(app, null, 2)}`, 'info');
    } else {
      log('ex3-log', 'No data. Create tree first!', 'warning');
    }
  });

  // Example 4: Scoped Proxies
  document.getElementById('ex4-scoped')?.addEventListener('click', () => {
    const settings = db.at('app.settings');
    settings.theme = 'dark';
    settings.language = 'en';
    settings.notifications = true;
    log('ex4-log', 'Set multiple settings using scoped proxy', 'success');
  });

  document.getElementById('ex4-batch')?.addEventListener('click', () => {
    db.batch((db: any) => {
      for (let i = 0; i < 10; i++) {
        db.data.items[`item${i}`] = { id: i, value: Math.random() };
      }
    });
    log('ex4-log', 'Created 10 items in a batch operation', 'success');
  });

  // Example 5: Persistence
  document.getElementById('ex5-save')?.addEventListener('click', () => {
    db.data.persistedData = {
      timestamp: Date.now(),
      message: 'This data persists across reloads',
      counter: (db.data.persistedData?.counter?.$value || 0) + 1
    };
    const state = db.saveState();
    localStorage.setItem('swirldb-example', btoa(String.fromCharCode(...state)));
    log('ex5-log', 'Saved state to localStorage', 'success');
  });

  document.getElementById('ex5-load')?.addEventListener('click', () => {
    const saved = localStorage.getItem('swirldb-example');
    if (saved) {
      const bytes = Uint8Array.from(atob(saved), c => c.charCodeAt(0));
      db.loadState(bytes);
      const data = db.data.persistedData.$value;
      log('ex5-log', `Loaded: ${JSON.stringify(data, null, 2)}`, 'success');
    } else {
      log('ex5-log', 'No saved data found', 'warning');
    }
  });

  document.getElementById('ex5-clear')?.addEventListener('click', () => {
    localStorage.removeItem('swirldb-example');
    log('ex5-log', 'Cleared localStorage', 'warning');
  });

  document.getElementById('ex5-reload')?.addEventListener('click', () => {
    location.reload();
  });

  // Initialize
  initialize();
</script>

<style>
  .demo-section {
    margin: 3rem 0;
    padding: 2rem;
    background: var(--bg-light);
    border-radius: 12px;
  }

  .demo-section h2 {
    margin-top: 0;
    color: var(--primary);
  }

  .demo-container {
    margin-top: 1.5rem;
  }

  .demo-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .demo-output {
    background: white;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
  }

  .log-area {
    max-height: 300px;
    overflow-y: auto;
    font-family: 'Monaco', 'Courier New', monospace;
    font-size: 0.9rem;
  }

  .log-entry {
    padding: 0.5rem;
    margin: 0.5rem 0;
    border-left: 3px solid var(--primary);
    background: var(--bg-light);
    border-radius: 4px;
  }

  .log-entry.success {
    border-left-color: var(--success);
    background: #edfff5;
  }

  .log-entry.warning {
    border-left-color: var(--warning);
    background: #fff9e6;
  }

  .log-entry.error {
    border-left-color: var(--error);
    background: #ffebeb;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }
</style>
