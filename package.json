{
  "name": "swirldb",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint packages --ext .ts --no-warn-ignored --max-warnings 0",
    "format": "prettier --write . --loglevel silent > /dev/null 2>&1",
    "format:check": "prettier --check .",
    "build": "npm run format && npm run lint && nx run-many --target=build --all",
    "ci-build": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "test:watch": "nx run-many --target=test --all --watch"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "esbuild": "^0.25.2",
    "eslint": "^9.24.0",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^29.6.4",
    "nx": "^18.0.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
